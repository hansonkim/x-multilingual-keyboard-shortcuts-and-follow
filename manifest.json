{
  "manifest_version": 3,
  "name": "X Multilingual Keyboard Shortcuts & Follow",
  "version": "1.0.8",
  "description": "Use all X.com keyboard shortcuts plus Follow/Unfollow (F), Modal (Y/N), and Tab navigation (g v/w/o) in any input language.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Multilingual Keyboard Shortcuts & Follow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
