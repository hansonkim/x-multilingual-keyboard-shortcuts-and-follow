{
  "manifest_version": 3,
  "name": "X Profile Follow Shortcut",
  "version": "1.0.5",
  "description": "Use all X.com (?) keyboard shortcuts plus Follow/Unfollow (F) & Modal (Y/N) in Korean, Japanese, Chinese, and any input language without switching IME.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Follow & Multilingual Shortcuts",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://pro.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
